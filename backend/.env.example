GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
# Lista separada por vírgula das origens autorizadas a chamar a API (CORS). Em dev, o padrão já
# cobre http://localhost:3000 — em produção, defina a URL real do frontend (Vercel).
INCLUIA_CORS_ORIGINS=http://localhost:3000
# Gestão Ativa: e-mail dos códigos de acesso. Em dev, EMAIL_MODO=console com AMBIENTE=dev mostra o
# código no console e em /gestao/dev/emails. Para enviar de verdade (e em produção): EMAIL_MODO=brevo,
# com a chave da API do Brevo e um remetente verificado no Brevo (caixa dedicada do projeto, não
# pessoal). Em dev, use brevo só com contas de teste: com uma base de contas reais, os códigos iriam
# a pessoas reais.
EMAIL_MODO=
BREVO_API_KEY=
EMAIL_REMETENTE=
EMAIL_REMETENTE_NOME=Escola Sem Barreiras
